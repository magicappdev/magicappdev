{
  "name": "@magicappdev/api",
  "version": "0.0.1",
  "description": "Backend API for MagicAppDev on Cloudflare Workers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "clean": "rm -rf dist node_modules",
    "deploy": "npx wrangler deploy -c wrangler.toml",
    "dev": "npx wrangler dev --persist-to ../../.wrangler/state",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@magicappdev/database": "workspace:*",
    "@magicappdev/shared": "workspace:*",
    "@types/sha256": "^0.2.2",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "crypto": "^1.0.1",
    "hono": "^4.11.5",
    "node-crypto": "^1.0.0",
    "sha256": "^0.2.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.4.1",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.128.0"
  }
}
