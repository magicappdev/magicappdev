{
  "name": "@magicappdev/cli",
  "version": "0.0.14",
  "description": "CLI tool for creating and managing MagicAppDev apps",
  "keywords": [
    "cli",
    "MagicAppDev",
    "app-dev"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "createmagicapp": "./bin/cli.js",
    "mad": "./bin/cli.js",
    "magicappdev": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@magicappdev/shared": "workspace:*",
    "@magicappdev/templates": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "open": "^11.0.2",
    "ora": "^9.4.1",
    "prompts": "^2.4.0",
    "tslib": "^2.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/prompts": "^2.4.0",
    "@types/ws": "^8.5.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
