{
  "name": "@magicappdev/database",
  "version": "0.0.1",
  "description": "Database utilities with Drizzle ORM for Cloudflare D1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "generate": "drizzle-kit generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate:local": "npx wrangler d1 migrations apply magicappdev-db --local --persist-to ../../.wrangler/state -c wrangler.toml",
    "migrate:prod": "npx wrangler d1 migrations apply magicappdev-db --remote -c wrangler.toml",
    "seed": "bun run seed.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@magicappdev/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^26.4.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.128.0"
  }
}
