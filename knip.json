{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    "apps/*": {},
    "packages/*": {}
  },
  "typescript": true,
  "eslint": true,
  "prettier": true,
  "ignore": [
    "knip.json",
    "**/*.d.ts",
    "apps/web/src/components/ui/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/*-example.ts",
    ".agents/**",
    ".claude/**",
    "templates/**",
    "apps/web/src/components/admin/__tests__/**",
    "apps/web/src/pages/chat/__tests__/**",
    "apps/web/e2e/**",
    "apps/web/src/test-setup.ts",
    "packages/cli/src/commands/*.ts",
    "packages/cli/src/lib/*.ts",
    "packages/templates/src/templates/**",
    "packages/templates/src/generators/**",
    "packages/templates/src/registry/**",
    "packages/templates/src/types.ts",
    "packages/templates/src/utils/**",
    "packages/shared/src/**",
    "packages/agent/src/minimal.ts",
    "packages/agent/src/test.ts"
  ],
  "commitlint": true,
  "husky": true,
  "ignoreDependencies": [
    "@magicappdev/*",
    "tslib",
    "@radix-ui/*",
    "ai",
    "zod",
    "@testing-library/react",
    "@testing-library/user-event",
    "@types/jsdom",
    "jsdom",
    "@commitlint/config-conventional",
    "@conventional-changelog/git-client",
    "@eslint/js",
    "expo-asset",
    "expo-updates"
  ],
  "ignoreBinaries": [],
  "ignoreExportsUsedInFile": true,
  "ignoreWorkspaces": [],
  "github-actions": true,
  "babel": true,
  "expo": true,
  "metro": true
}
