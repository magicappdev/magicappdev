{
  "name": "@magicappdev/monorepo",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicappdev/magicappdev.git"
  },
  "license": "MIT",
  "author": {
    "name": "involvex"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.0"
    }
  },
  "trustedDependencies": [
    "canvas",
    "core-js",
    "core-js-pure",
    "cypress",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "scripts": {
    "prebuild": "bun run format && bun run lint:fix && bun run typecheck",
    "build": "turbo build",
    "build:agent": "turbo build --filter=@magicappdev/agent",
    "build:mobile": "turbo build --filter=@magicappdev/mobile",
    "typecheck:mobile": "turbo typecheck --filter=@magicappdev/mobile",
    "lint:mobile": "turbo lint --filter=@magicappdev/mobile",
    "expo:check": "cd apps/mobile && bunx expo install --check",
    "build:api": "turbo build --filter=@magicappdev/api",
    "build:axiom": "turbo build --filter=@magicappdev/axiom-cloudflare-workers",
    "build:cli": "turbo build --filter=@magicappdev/cli",
    "build:db": "turbo build --filter=@magicappdev/database",
    "build:llmchat": "turbo build --filter=@magicappdev/llmchat",
    "build:shared": "turbo build --filter=@magicappdev/shared",
    "build:templates": "turbo build --filter=@magicappdev/templates-engine",
    "build:web": "turbo build --filter=@magicappdev/web",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "verify:mark": "bun -e \"import { mkdirSync, writeFileSync } from 'fs'; mkdirSync('.pipeline', { recursive: true }); writeFileSync('.pipeline/last-verify.json', JSON.stringify({ passed: true, at: new Date().toISOString() }));\"",
    "verify": "bun run check && bun run verify:mark",
    "check": "turbo build lint typecheck test && bun run --filter=@magicappdev/mobile check",
    "clean": "turbo run clean && bun -e \"fs.rmSync('node_modules', { recursive: true, force: true })\"",
    "deploy:agent": "turbo run deploy --filter=@magicappdev/agent",
    "deploy:api": "turbo run deploy --filter=@magicappdev/api",
    "deploy:axiom": "turbo run deploy --filter=@magicappdev/axiom-cloudflare-workers",
    "deploy:cli": "turbo run deploy --filter=@magicappdev/cli",
    "deploy:db": "turbo run deploy --filter=@magicappdev/database",
    "deploy:llm": "turbo run deploy --filter=@magicappdev/llmchat",
    "deploy:web": "turbo run deploy --filter=@magicappdev/web",
    "deploy:all": "powershell -F scripts/deploy.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "postinstall": "node -e \"console.log('Skipping Windows powershell postinstall on non-Windows CI')\" || powershell -ExecutionPolicy Bypass -File scripts/postinstall.ps1",
    "prepare": "husky",
    "test": "turbo test --concurrency=1",
    "typecheck": "turbo typecheck",
    "android": "bun run --filter=@magicappdev/mobile android"
  },
  "dependencies": {
    "turbo": "^2.10.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@conventional-changelog/git-client": "^3.1.2",
    "@types/node": "^26.4.1",
    "conventional-changelog": "^8.1.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sort-imports": "^1.8.11",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "@babel/core": "^7.29.1",
    "@humanfs/node": "^0.16.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "body-parser": "^2.3.0",
    "esbuild": ">=0.25.0",
    "fast-uri": "^3.1.6",
    "ip-address": "^10.3.1",
    "jsondiffpatch": ">=0.6.0",
    "js-yaml": ">=4.1.0",
    "@conventional-changelog/git-client": ">=2.5.1",
    "@conventional-changelog/git-client@<2.0.0": ">=2.0.0",
    "ai@<5.0.52": ">=5.0.52",
    "ai": ">=5.0.52",
    "esbuild@<=0.24.2": ">=0.25.0",
    "jsondiffpatch@<0.7.2": ">=0.7.2",
    "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
    "path-to-regexp@^8.0.0": "^8.4.0",
    "picomatch": "^2.3.2",
    "picomatch@^4.0.0": "^4.0.4",
    "qs": "^6.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tar": ">=7.5.7",
    "tar@<=7.5.3": ">=7.5.4",
    "undici": ">=7.18.2",
    "undici@>=7.0.0 <7.18.2": ">=7.18.2",
    "wrangler@>=4.0.0 <4.59.1": ">=4.59.1",
    "yaml": "^2.8.3"
  }
}
