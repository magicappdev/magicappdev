  "scripts": {
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "build": "expo export --platform android --output-dir dist",
    "clean": "bun -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('.expo', { recursive: true, force: true })\"",
    "dev": "expo start",
    "export:android": "expo export --platform android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "prebuild:android": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
