{
  "name": "@magicappdev/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist node_modules",
    "deploy": "npx wrangler deploy -c wrangler.toml",
    "dev": "vite -m dev",
    "format": "prettier --write .",
    "lint": "eslint . --ignore-pattern '*.d.ts'",
    "lint:fix": "eslint --fix .",
    "preview": "wrangler dev",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run --exclude 'e2e/**'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.13.0",
    "@google/stitch-sdk": "^0.3.5",
    "@magicappdev/database": "workspace:*",
    "@magicappdev/shared": "workspace:*",
    "@magicappdev/templates-engine": "workspace:*",
    "@marsidev/react-turnstile": "^1.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/themes": "^3.2.1",
    "@stackblitz/sdk": "^1.11.1",
    "ai": "^7.0.91",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.11.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.27",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  }
}
